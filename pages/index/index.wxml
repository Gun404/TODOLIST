<!-- index.wxml - 待办清单主页面结构 -->
<!--
  页面整体布局：
  1. 顶部英雄区：日期 + 统计数字 + 进度条 + 动态激励文案
  2. 输入区：输入框 + 添加按钮
  3. 列表区：wx:for 动态渲染未完成/已完成任务，wx:if 控制分组显示
  4. 空状态：isEmpty 为 true 时展示
-->
<view class="page-wrapper">

  <!-- ===== 顶部英雄区域 ===== -->
  <view class="hero-section">
    <!-- 当前日期，由 onLoad 动态计算后 setData 写入 -->
    <view class="hero-date">{{currentDate}}</view>
    <view class="hero-title">我的待办清单</view>

    <!-- 统计摘要卡片（绑定 JS 中的 doneCount / todoCount） -->
    <view class="hero-stats">
      <view class="stat-item">
        <!-- 已完成数量，由 loadTodos() 实时计算更新 -->
        <text class="stat-num">{{doneCount}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <!-- 未完成数量 -->
        <text class="stat-num">{{todoCount}}</text>
        <text class="stat-label">未完成</text>
      </view>
    </view>

    <!--
      进度条区域（Step 5 新增亮点）
      显示今日任务完成百分比，通过 style 动态设置进度条宽度
    -->
    <view class="progress-section">
      <!-- 动态激励文案：根据完成进度由 loadTodos 选取不同文案 -->
      <view class="progress-label-row">
        <text class="progress-motivation">{{motivationText}}</text>
        <!-- 完成百分比数字，为 0 时不显示避免歧义 -->
        <text class="progress-percent" wx:if="{{completedPercent > 0}}">{{completedPercent}}%</text>
      </view>
      <!-- 进度条轨道（背景） -->
      <view class="progress-track">
        <!--
          进度条填充部分
          style 中的 width 由 completedPercent 驱动（0% ~ 100%）
          transition 由 WXSS 中定义，切换任务状态时有平滑动画
        -->
        <view class="progress-fill" style="width: {{completedPercent}}%;"></view>
      </view>
    </view>
  </view>

  <!-- ===== 输入区域 ===== -->
  <view class="input-section">
    <view class="input-wrapper">
      <!-- 输入框图标 -->
      <text class="input-icon">✏️</text>
      <!--
        任务输入框
        bindinput：实时监听输入内容，赋值给 data.inputValue
        bindconfirm：键盘右下角"完成/发送"键触发添加，提升输入体验
        value：双向绑定 inputValue，便于 addTodo 执行后清空输入框
      -->
      <input
        id="taskInput"
        class="task-input"
        placeholder="添加新的待办事项..."
        placeholder-class="input-placeholder"
        value="{{inputValue}}"
        bindinput="onInputChange"
        bindconfirm="addTodo"
        confirm-type="done"
      />
    </view>
    <!--
      添加按钮
      bindtap：点击"+"按钮触发 addTodo 方法
    -->
    <view class="add-btn" id="addBtn" bindtap="addTodo">
      <text class="add-btn-icon">+</text>
    </view>
  </view>

  <!-- ===== 任务列表区域（有数据时显示） ===== -->
  <!--
    wx:if="{{!isEmpty}}"：只要 todos 数组不为空就渲染此区域
    scroll-y：开启垂直滚动，防止长列表溢出屏幕
  -->
  <scroll-view class="list-section" scroll-y="true" wx:if="{{!isEmpty}}">

    <!-- --- 未完成任务分组（存在未完成任务时才显示） --- -->
    <view wx:if="{{hasTodo}}">
      <view class="group-header">
        <view class="group-dot dot-active"></view>
        <text class="group-title">待完成</text>
        <!-- 动态绑定未完成数量角标 -->
        <text class="group-count">{{todoCount}}</text>
      </view>

      <!--
        wx:for：遍历 todos 数组中所有未完成（completed === false）的任务
        wx:if：过滤条件，只渲染未完成项
        wx:key：使用任务唯一 id 作为 key，提升列表渲染性能
        item：当前遍历到的任务对象（默认变量名）
      -->
      <view
        wx:for="{{todos}}"
        wx:key="id"
        wx:if="{{!item.completed}}"
        class="task-item"
        id="todo-{{item.id}}"
      >
        <!--
          复选框 - 未选中状态
          bindtap：点击触发 toggleTodo，切换为已完成
          data-id：将任务 id 传入事件对象供方法读取
        -->
        <view class="task-check unchecked" data-id="{{item.id}}" bindtap="toggleTodo">
          <view class="check-inner"></view>
        </view>
        <!-- 任务文字内容区 -->
        <view class="task-content-wrap">
          <text class="task-text">{{item.content}}</text>
          <text class="task-time">{{item.createTime}}</text>
        </view>
        <!--
          删除按钮
          bindtap：点击触发 deleteTodo，弹出确认框后删除
          data-id：将任务 id 传入事件对象
        -->
        <view class="task-delete-btn" data-id="{{item.id}}" id="del-{{item.id}}" bindtap="deleteTodo">
          <text class="delete-icon">🗑</text>
        </view>
      </view>
    </view>

    <!-- --- 已完成任务分组（存在已完成任务时才显示） --- -->
    <view wx:if="{{hasDone}}">
      <view class="group-header group-header-done">
        <view class="group-dot dot-done"></view>
        <text class="group-title">已完成</text>
        <!-- 动态绑定已完成数量角标 -->
        <text class="group-count" style="background:#AAAAAA;">{{doneCount}}</text>
      </view>

      <!--
        遍历 todos 中已完成（completed === true）的任务
        task-item-done：已完成任务卡片样式（降低对比度 + 删除线）
      -->
      <view
        wx:for="{{todos}}"
        wx:key="id"
        wx:if="{{item.completed}}"
        class="task-item task-item-done"
        id="done-{{item.id}}"
      >
        <!--
          复选框 - 已选中状态
          bindtap：点击触发 toggleTodo，切换回未完成
          data-id：将任务 id 传入事件对象
        -->
        <view class="task-check checked" data-id="{{item.id}}" bindtap="toggleTodo">
          <text class="check-tick">✓</text>
        </view>
        <!-- 任务文字内容区 -->
        <view class="task-content-wrap">
          <!-- task-text-done：渲染删除线 + 灰色 -->
          <text class="task-text task-text-done">{{item.content}}</text>
          <text class="task-time">{{item.createTime}}</text>
        </view>
        <!--
          删除按钮（已完成任务）
          bindtap：点击触发 deleteTodo，弹出确认框后删除
          data-id：将任务 id 传入事件对象
        -->
        <view class="task-delete-btn" data-id="{{item.id}}" id="del-done-{{item.id}}" bindtap="deleteTodo">
          <text class="delete-icon">🗑</text>
        </view>
      </view>
    </view>

    <!-- 底部留白，防止最后一条任务被遮挡 -->
    <view class="list-bottom-spacer"></view>
  </scroll-view>

  <!-- ===== 空状态区域 ===== -->
  <!--
    wx:else：当 isEmpty 为 true（即 todos 数组为空）时，渲染此空状态提示
    引导用户添加第一个待办事项
  -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-title">一切井然有序！</text>
    <text class="empty-subtitle">点击上方输入框，添加你的第一个待办事项</text>
  </view>

</view>
