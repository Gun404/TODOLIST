/* index.wxss - 首页样式 */
/* 设计风格：极简主义 + 柔和阴影 + 圆角卡片 */
/* 主色调：紫罗兰 #6C63FF，辅色：浅灰 #F4F5F9 */

/* ===== 页面容器 ===== */
.page-wrapper {
  min-height: 100vh;
  background-color: #F4F5F9;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部英雄区域 ===== */
.hero-section {
  background: linear-gradient(135deg, #6C63FF 0%, #8B85FF 100%);
  padding: 60rpx 40rpx 50rpx;
  border-radius: 0 0 48rpx 48rpx;
  /* 底部阴影增加层次感 */
  box-shadow: 0 8rpx 32rpx rgba(108, 99, 255, 0.35);
}

/* 日期文字 */
.hero-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

/* 主标题 */
.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 32rpx;
}

/* 统计摘要容器 */
.hero-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 20rpx 32rpx;
  /* 玻璃拟态效果 */
  backdrop-filter: blur(10px);
}

/* 单个统计项 */
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

/* 统计数字 */
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

/* 统计标签 */
.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* 分隔线 */
.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 16rpx;
}

/* ===== 输入区域 ===== */
.input-section {
  display: flex;
  align-items: center;
  margin: 32rpx 32rpx 16rpx;
  gap: 16rpx;
}

/* 输入框外层容器（白色圆角卡片） */
.input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 24rpx;
  height: 88rpx;
  /* 微阴影 */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 输入框内图标 */
.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

/* 实际输入框 */
.task-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  height: 88rpx;
  line-height: 88rpx;
}

/* 输入框占位符样式 */
.input-placeholder {
  color: #BBBBBB;
  font-size: 28rpx;
}

/* 添加按钮 */
.add-btn {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #6C63FF 0%, #8B85FF 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(108, 99, 255, 0.45);
  /* 点击时微缩放效果（通过active伪类） */
  transition: transform 0.1s ease;
}

.add-btn:active {
  transform: scale(0.93);
}

/* 添加按钮的加号图标 */
.add-btn-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* ===== 列表区域 ===== */
.list-section {
  flex: 1;
  padding: 0 32rpx;
  /* 设置 scroll-view 高度（让其可滚动） */
  height: calc(100vh - 380rpx);
}

/* 分组标题行 */
.group-header {
  display: flex;
  align-items: center;
  margin: 24rpx 0 16rpx;
}

/* 已完成分组额外上间距 */
.group-header-done {
  margin-top: 40rpx;
}

/* 分组颜色点 */
.group-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

/* 未完成分组 - 蓝紫色点 */
.dot-active {
  background: #6C63FF;
}

/* 已完成分组 - 浅灰色点 */
.dot-done {
  background: #AAAAAA;
}

/* 分组标题文字 */
.group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #555555;
  flex: 1;
}

/* 分组任务数量角标 */
.group-count {
  font-size: 22rpx;
  color: #FFFFFF;
  background: #6C63FF;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* ===== 任务卡片 ===== */
.task-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  /* 点击反馈 */
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.task-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}

/* 已完成任务卡片 - 降低对比度 */
.task-item-done {
  background: #F9F9FB;
  box-shadow: none;
  opacity: 0.8;
}

/* 复选框 - 未选中状态 */
.task-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #6C63FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  /* 点击动画 */
  transition: all 0.2s ease;
}

/* 复选框未选中状态 - 内部小圆点 */
.check-inner {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: transparent;
}

/* 复选框已选中状态 */
.task-check.checked {
  background: linear-gradient(135deg, #6C63FF, #8B85FF);
  border-color: transparent;
}

/* 勾选符号 */
.check-tick {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 任务文字内容区 */
.task-content-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 任务主文字 */
.task-text {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  line-height: 1.5;
}

/* 已完成任务文字 - 删除线 + 变灰 */
.task-text-done {
  text-decoration: line-through;
  color: #AAAAAA;
  font-weight: 400;
}

/* 任务时间标签 */
.task-time {
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 6rpx;
}

/* 删除按钮 */
.task-delete-btn {
  padding: 8rpx 8rpx 8rpx 16rpx;
  flex-shrink: 0;
}

.delete-icon {
  font-size: 32rpx;
  opacity: 0.45;
}

.delete-icon:active {
  opacity: 0.9;
}

/* 列表底部留白 */
.list-bottom-spacer {
  height: 40rpx;
}

/* ===== 空状态区域 ===== */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 60rpx;
  margin-top: 40rpx;
}

/* 空状态大图标 */
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

/* 空状态主标题 */
.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #555555;
  margin-bottom: 16rpx;
}

/* 空状态副标题 */
.empty-subtitle {
  font-size: 26rpx;
  color: #AAAAAA;
  text-align: center;
  line-height: 1.8;
}
